@namespace FitPrivacyCleaner.Browser
@using System.Text.Json
@using FitPrivacyCleaner
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div aria-hidden="true" hidden></div>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private DotNetObjectReference<App>? _reference;

    private sealed record CleanResponse(
        string FileBase64,
        int RemovedGpsFields,
        int RemovedLocationFields,
        int RemovedIdentifierFields,
        int RemovedHeartRateFields,
        int RemovedPowerFields,
        int RemovedCadenceFields,
        int RemovedMetadataMessages,
        int RemovedDeveloperFields,
        int OriginalMessageCount,
        int OutputMessageCount);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _reference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("fitCleanerInterop.set", _reference);
    }

    [JSInvokable]
    public string Ping() => "FIT_CLEANER_READY";

    [JSInvokable]
    public string Analyze(string fileBase64)
    {
        var bytes = Convert.FromBase64String(fileBase64);
        var result = FitFileProcessor.Analyze(bytes);
        return JsonSerializer.Serialize(result, JsonOptions);
    }

    [JSInvokable]
    public string Clean(
        string fileBase64,
        bool removeGps,
        bool removeDeviceAndProfileData,
        bool removeHeartRate,
        bool removePower,
        bool removeCadence,
        bool removeDeveloperData) =>
        CleanInternal(fileBase64, removeGps, removeGps, removeDeviceAndProfileData,
            removeHeartRate, removePower, removeCadence, removeDeveloperData);

    [JSInvokable]
    public string CleanV2(
        string fileBase64,
        bool removeGps,
        bool removeLocation,
        bool removeDeviceAndProfileData,
        bool removeHeartRate,
        bool removePower,
        bool removeCadence,
        bool removeDeveloperData) =>
        CleanInternal(fileBase64, removeGps, removeLocation, removeDeviceAndProfileData,
            removeHeartRate, removePower, removeCadence, removeDeveloperData);

    private string CleanInternal(
        string fileBase64,
        bool removeGps,
        bool removeLocation,
        bool removeDeviceAndProfileData,
        bool removeHeartRate,
        bool removePower,
        bool removeCadence,
        bool removeDeveloperData)
    {
        var bytes = Convert.FromBase64String(fileBase64);
        var result = FitFileProcessor.Clean(
            bytes,
            new CleanOptions(
                RemoveGps: removeGps,
                RemoveDeviceAndProfileData: removeDeviceAndProfileData,
                RemoveHeartRate: removeHeartRate,
                RemovePower: removePower,
                RemoveCadence: removeCadence,
                RemoveDeveloperData: removeDeveloperData,
                RemoveLocation: removeLocation));

        return JsonSerializer.Serialize(new CleanResponse(
            FileBase64: Convert.ToBase64String(result.FileBytes),
            RemovedGpsFields: result.RemovedGpsFields,
            RemovedLocationFields: result.RemovedLocationFields,
            RemovedIdentifierFields: result.RemovedIdentifierFields,
            RemovedHeartRateFields: result.RemovedHeartRateFields,
            RemovedPowerFields: result.RemovedPowerFields,
            RemovedCadenceFields: result.RemovedCadenceFields,
            RemovedMetadataMessages: result.RemovedMetadataMessages,
            RemovedDeveloperFields: result.RemovedDeveloperFields,
            OriginalMessageCount: result.OriginalMessageCount,
            OutputMessageCount: result.OutputMessageCount), JsonOptions);
    }

    public ValueTask DisposeAsync()
    {
        _reference?.Dispose();
        return ValueTask.CompletedTask;
    }
}
